{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://environment-studio.invalid/schemas/guarded-payload-v1.schema.json",
  "title": "Closed guarded payload v1 \u2014 planned contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bindingId",
    "engine",
    "storage",
    "table",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "bindingId": {
      "$ref": "#/$defs/id"
    },
    "engine": {
      "enum": [
        "postgresql",
        "oracle"
      ]
    },
    "storage": {
      "enum": [
        "text",
        "clob"
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "name",
        "keyColumn",
        "xmlColumn",
        "keyType"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/sqlIdentifier"
        },
        "name": {
          "$ref": "#/$defs/sqlIdentifier"
        },
        "keyColumn": {
          "$ref": "#/$defs/sqlIdentifier"
        },
        "xmlColumn": {
          "$ref": "#/$defs/sqlIdentifier"
        },
        "keyType": {
          "enum": [
            "text",
            "int64"
          ]
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "key",
          "originalHex",
          "targetHex"
        ],
        "properties": {
          "documentId": {
            "$ref": "#/$defs/id"
          },
          "key": {
            "$ref": "#/$defs/key"
          },
          "originalHex": {
            "$ref": "#/$defs/hex"
          },
          "targetHex": {
            "$ref": "#/$defs/hex"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$(?![\\s\\S])",
      "maxLength": 64
    },
    "sqlIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$(?![\\s\\S])",
      "maxLength": 128
    },
    "hex": {
      "type": "string",
      "pattern": "^[0-9a-f]+$(?![\\s\\S])",
      "minLength": 2,
      "maxLength": 6291456,
      "description": "Even length, strict UTF-8, qualified XML and aggregate budgets are mandatory semantic checks."
    },
    "key": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "int64"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]{0,18})$(?![\\s\\S])",
              "maxLength": 20
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "engine": {
            "const": "postgresql"
          }
        }
      },
      "then": {
        "properties": {
          "storage": {
            "const": "text"
          }
        }
      },
      "else": {
        "properties": {
          "storage": {
            "const": "clob"
          }
        }
      }
    }
  ]
}
