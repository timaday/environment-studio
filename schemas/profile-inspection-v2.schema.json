{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://environment.studio/schemas/profile-inspection-v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$(?![\\s\\S])"
    },
    "revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$(?![\\s\\S])",
      "maxLength": 1024
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$(?![\\s\\S])"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$(?![\\s\\S])"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "requiredInputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,63}$(?![\\s\\S])"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "type",
          "label",
          "requiredInputs"
        ]
      },
      "minItems": 1,
      "maxItems": 20000
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$(?![\\s\\S])"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$(?![\\s\\S])"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$(?![\\s\\S])"
          }
        },
        "required": [
          "type",
          "from",
          "to"
        ]
      },
      "maxItems": 50000
    },
    "logicalDefinitionDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "logicalDefinitionDigest",
    "entities",
    "relations"
  ]
}
