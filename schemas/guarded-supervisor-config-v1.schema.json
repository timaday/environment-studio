{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://environment-studio.invalid/schemas/guarded-supervisor-config-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "sessionLauncher",
    "terminalControl",
    "clients",
    "destinations"
  ],
  "properties": {
    "formatVersion": {
      "const": "es-guarded-supervisor-config-v1"
    },
    "sessionLauncher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000\\r\\n]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "terminalControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000\\r\\n]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "version",
          "runtimeRoot",
          "runtimeIdentity",
          "executableSha256"
        ],
        "properties": {
          "family": {
            "enum": [
              "psql",
              "sqlplus"
            ]
          },
          "version": {
            "enum": [
              "18.6",
              "23.26.3.0.0"
            ]
          },
          "runtimeRoot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/[^\\u0000\\r\\n]*$"
          },
          "runtimeIdentity": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "executableSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "orapkiSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "family": {
                  "const": "psql"
                }
              }
            },
            "then": {
              "properties": {
                "version": {
                  "const": "18.6"
                }
              },
              "not": {
                "required": [
                  "orapkiSha256"
                ],
                "properties": {
                  "orapkiSha256": {}
                }
              }
            },
            "else": {
              "properties": {
                "version": {
                  "const": "23.26.3.0.0"
                },
                "orapkiSha256": {}
              },
              "required": [
                "orapkiSha256"
              ]
            }
          }
        ]
      }
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "engine",
          "host",
          "port",
          "database",
          "transportIdentity",
          "provisioningPolicyVersion",
          "expectedPhysicalIdentity",
          "trustMaterial"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "engine": {
            "enum": [
              "postgresql",
              "oracle"
            ]
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "database": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_]{1,128}$"
          },
          "transportIdentity": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "provisioningPolicyVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9.\\-:_]+$"
          },
          "expectedPhysicalIdentity": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "systemIdentifier",
                  "databaseOid",
                  "databaseName"
                ],
                "properties": {
                  "systemIdentifier": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20,
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "databaseOid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20,
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "databaseName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dbid",
                  "dbUniqueName",
                  "conId",
                  "conUid",
                  "conName",
                  "pdbGuid"
                ],
                "properties": {
                  "dbid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20,
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "dbUniqueName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                  },
                  "conId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20,
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "conUid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20,
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "conName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                  },
                  "pdbGuid": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  }
                }
              }
            ]
          },
          "trustMaterial": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^/[^\\u0000\\r\\n]*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "engine": {
                  "const": "postgresql"
                }
              }
            },
            "then": {
              "properties": {
                "expectedPhysicalIdentity": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "systemIdentifier",
                    "databaseOid",
                    "databaseName"
                  ],
                  "properties": {
                    "systemIdentifier": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20,
                      "pattern": "^[1-9][0-9]{0,19}$"
                    },
                    "databaseOid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20,
                      "pattern": "^[1-9][0-9]{0,19}$"
                    },
                    "databaseName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "expectedPhysicalIdentity": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dbid",
                    "dbUniqueName",
                    "conId",
                    "conUid",
                    "conName",
                    "pdbGuid"
                  ],
                  "properties": {
                    "dbid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20,
                      "pattern": "^[1-9][0-9]{0,19}$"
                    },
                    "dbUniqueName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                    },
                    "conId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20,
                      "pattern": "^[1-9][0-9]{0,19}$"
                    },
                    "conUid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20,
                      "pattern": "^[1-9][0-9]{0,19}$"
                    },
                    "conName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                    },
                    "pdbGuid": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{32}$"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
