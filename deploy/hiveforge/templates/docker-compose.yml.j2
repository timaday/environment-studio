# Rendered by HiveForge for the Environment Studio PostgreSQL 16.11 no-OIDC pilot.
# Secret values are interpolated from the HiveForge/target runtime environment and are not stored here.
services:
  environment-studio-workspace-init:
    image: ${STUDIO_IMAGE:?Set STUDIO_IMAGE to the published ghcr.io image digest}
    platform: linux/amd64
    profiles: ["init"]
    command: ["--initialize-workspace-v3=/workspace"]
    user: "10001:10001"
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=128m
    volumes:
      - type: bind
        source: ${STUDIO_WORKSPACE_HOST_PATH:?Set STUDIO_WORKSPACE_HOST_PATH to a private host directory owned by uid/gid 10001}
        target: /workspace

  environment-studio:
    image: ${STUDIO_IMAGE:?Set STUDIO_IMAGE to the published ghcr.io image digest}
    platform: linux/amd64
    restart: unless-stopped
    ports:
      - "${STUDIO_BIND_ADDRESS:-127.0.0.1}:${STUDIO_HOST_PORT:-18181}:8080"
    environment:
      STUDIO_MODE: hosted
      STUDIO_SECURITY_PUBLIC_ORIGIN: ${STUDIO_SECURITY_PUBLIC_ORIGIN:?Set the exact public origin}
      STUDIO_SECURITY_LOCAL_OPERATOR_ENABLED: "true"
      STUDIO_SECURITY_LOCAL_OPERATOR_USERNAME: ${STUDIO_SECURITY_LOCAL_OPERATOR_USERNAME:-operator}
      STUDIO_SECURITY_LOCAL_OPERATOR_PASSWORD: ${STUDIO_SECURITY_LOCAL_OPERATOR_PASSWORD:?Set through HiveForge secret handling}
      STUDIO_SECURITY_LOCAL_OPERATOR_ISSUER: ${STUDIO_SECURITY_LOCAL_OPERATOR_ISSUER:-https://local-operator.environment-studio.invalid}
      STUDIO_SECURITY_LOCAL_OPERATOR_SUBJECT: ${STUDIO_SECURITY_LOCAL_OPERATOR_SUBJECT:-operator}
      STUDIO_WORKSPACE_DIRECTORY: /workspace
      SERVER_SERVLET_SESSION_COOKIE_SECURE: ${STUDIO_SESSION_COOKIE_SECURE:-true}
      SPRING_APPLICATION_JSON: >-
        {
          "studio": {
            "workspace": {
              "definition-publishers": [
                {
                  "issuer": "${STUDIO_DEFINITION_PUBLISHER_ISSUER:-https://local-operator.environment-studio.invalid}",
                  "subject": "${STUDIO_DEFINITION_PUBLISHER_SUBJECT:-operator}"
                }
              ]
            }
          }
        }
    user: "10001:10001"
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=128m
    volumes:
      - type: bind
        source: ${STUDIO_WORKSPACE_HOST_PATH:?Set STUDIO_WORKSPACE_HOST_PATH to a private host directory owned by uid/gid 10001}
        target: /workspace
    healthcheck:
      test: ["CMD", "java", "-cp", "/opt/studio/probe", "HealthProbe"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 30s
    mem_limit: 1g
    cpus: 1.0
    pids_limit: 256
    stop_grace_period: 30s
    ulimits:
      core: 0
