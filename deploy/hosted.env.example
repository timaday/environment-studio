# Environment Studio hosted PostgreSQL 16.11 pilot settings.
# Copy outside the repository for real use, fill values, chmod 0600, and never commit secrets.

STUDIO_IMAGE=ghcr.io/timaday/environment-studio@sha256:REPLACE_WITH_EMITTED_DIGEST
STUDIO_HOST_PORT=18181
STUDIO_WORKSPACE_HOST_PATH=/home/tim/.local/share/environment-studio/workspace
STUDIO_PG_TRUST_MATERIAL_HOST_PATH=/home/tim/.local/share/environment-studio/postgres-ca.pem

STUDIO_SECURITY_PUBLIC_ORIGIN=http://localhost:18181
STUDIO_SECURITY_LOCAL_OPERATOR_USERNAME=operator
STUDIO_SECURITY_LOCAL_OPERATOR_PASSWORD=replace-through-secret-manager
STUDIO_SECURITY_LOCAL_OPERATOR_ISSUER=https://local-operator.environment-studio.invalid
STUDIO_SECURITY_LOCAL_OPERATOR_SUBJECT=operator
STUDIO_SESSION_COOKIE_SECURE=false

STUDIO_DEFINITION_PUBLISHER_ISSUER=https://local-operator.environment-studio.invalid
STUDIO_DEFINITION_PUBLISHER_SUBJECT=operator

STUDIO_PG_DESTINATION_ID=postgresql-pilot
STUDIO_PG_HOST=postgres.example.test
STUDIO_PG_PORT=5432
STUDIO_PG_DATABASE=appdb
STUDIO_PG_TRANSPORT_IDENTITY_SHA256=replace_with_64_lowercase_hex_sha256
STUDIO_PG_SYSTEM_IDENTIFIER=replace_with_observed_numeric_system_identifier
STUDIO_PG_DATABASE_OID=replace_with_observed_numeric_database_oid

STUDIO_DESTINATION_OWNER_ISSUER=https://local-operator.environment-studio.invalid
STUDIO_DESTINATION_OWNER_SUBJECT=operator
