  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "schemas": {
      "Uuid": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
      },
      "Revision": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$(?![\\s\\S])",
        "maxLength": 1024
      },
      "ExpectedRevision": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$(?![\\s\\S])",
        "maxLength": 1024
      },
      "Digest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
      },
      "DeclaredId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{0,63}$(?![\\s\\S])"
      },
      "Diagnostic": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "code",
          "pointer",
          "message"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "parse",
              "shape",
              "semantic",
              "publication"
            ]
          },
          "code": {
            "type": "string"
          },
          "pointer": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^WORKSPACE_[A-Z_]+$"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Rejected": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "diagnostics"
        ],
        "properties": {
          "kind": {
            "const": "rejected"
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "minItems": 1,
            "maxItems": 256
          }
        }
      },
      "ExportPolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bindingId",
          "documentId",
          "content"
        ],
        "properties": {
          "bindingId": {
            "$ref": "#/components/schemas/DeclaredId"
          },
          "documentId": {
            "$ref": "#/components/schemas/DeclaredId"
          },
          "content": {
            "type": "string",
            "enum": [
              "deny",
              "protected-self-contained"
            ]
          }
        }
      },
      "ExportPolicies": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ExportPolicy"
        },
        "maxItems": 20000,
        "description": "Exactly one explicit choice for each binding/document, sorted by binding ID then document ID in outputs. No duplicates or defaults.",
        "minItems": 1
      },
      "Mechanisms": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "xml-path-v1",
          "xml-span-v1",
          "generic-graph-v1",
          "native-compiler-v3",
          "derived-graph-v1"
        ],
        "properties": {
          "xml-path-v1": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(?![\\s\\S])",
            "maxLength": 1024
          },
          "xml-span-v1": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(?![\\s\\S])",
            "maxLength": 1024
          },
          "generic-graph-v1": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(?![\\s\\S])",
            "maxLength": 1024
          },
          "xml-child-property-v1": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(?![\\s\\S])",
            "maxLength": 1024
          },
          "native-compiler-v3": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(?![\\s\\S])",
            "maxLength": 1024
          },
          "derived-graph-v1": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(?![\\s\\S])",
            "maxLength": 1024
          }
        }
      },
      "BindingDigests": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^[a-z][a-z0-9.-]{0,63}$(?![\\s\\S])": {
            "$ref": "#/components/schemas/Digest"
          }
        }
      },
      "SaveDefinition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedRevision",
          "requestId",
          "format",
          "source"
        ],
        "properties": {
          "expectedRevision": {
            "$ref": "#/components/schemas/ExpectedRevision"
          },
          "requestId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "format": {
            "type": "string",
            "enum": [
              "JSON",
              "YAML"
            ]
          },
          "source": {
            "type": "string",
            "description": "Exact source; at most 1 MiB strict UTF-8, original numeric notation preserved."
          }
        }
      },
      "DefinitionProjection": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/DefinitionIncompleteProjection"
          },
          {
            "$ref": "#/components/schemas/DefinitionHistoricalReadyProjection"
          }
        ]
      },
      "DefinitionPublication": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "digest",
          "sourceRevision",
          "exportPolicies"
        ],
        "properties": {
          "digest": {
            "$ref": "#/components/schemas/Digest"
          },
          "sourceRevision": {
            "$ref": "#/components/schemas/Revision"
          },
          "exportPolicies": {
            "$ref": "#/components/schemas/ExportPolicies"
          }
        }
      },
      "DefinitionRevision": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectId",
              "workspaceRevision",
              "sourceDigest",
              "format",
              "source",
              "schemaVersion",
              "compilerVersion",
              "projection",
              "state"
            ],
            "properties": {
              "objectId": {
                "$ref": "#/components/schemas/Uuid"
              },
              "workspaceRevision": {
                "$ref": "#/components/schemas/Revision"
              },
              "sourceDigest": {
                "$ref": "#/components/schemas/Digest"
              },
              "format": {
                "type": "string",
                "enum": [
                  "JSON",
                  "YAML"
                ]
              },
              "source": {
                "type": "string",
                "description": "Exact source; at most 1 MiB strict UTF-8, original numeric notation preserved."
              },
              "schemaVersion": {
                "const": "3"
              },
              "compilerVersion": {
                "const": "native-compiler-v3"
              },
              "projection": {
                "$ref": "#/components/schemas/DefinitionProjection"
              },
              "state": {
                "const": "draft"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectId",
              "workspaceRevision",
              "sourceDigest",
              "format",
              "source",
              "schemaVersion",
              "compilerVersion",
              "projection",
              "state",
              "publication"
            ],
            "properties": {
              "objectId": {
                "$ref": "#/components/schemas/Uuid"
              },
              "workspaceRevision": {
                "$ref": "#/components/schemas/Revision"
              },
              "sourceDigest": {
                "$ref": "#/components/schemas/Digest"
              },
              "format": {
                "type": "string",
                "enum": [
                  "JSON",
                  "YAML"
                ]
              },
              "source": {
                "type": "string",
                "description": "Exact source; at most 1 MiB strict UTF-8, original numeric notation preserved."
              },
